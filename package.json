{
  "name": "pptx-font-manager-addin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A PowerPoint task-pane add-in that scans the open deck for the fonts it actually uses, checks which are installed on this machine, and offers the missing ones as real downloads, metric-compatible substitutes, or a sidecar bundle. Reuses the pptx-font-manager scanner verbatim.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc --noEmit",
    "test": "vitest run",
    "certs": "office-addin-dev-certs install",
    "validate": "office-addin-manifest validate manifest.xml",
    "sideload:mac": "bash scripts/sideload-mac.sh",
    "sideload:windows": "pwsh scripts/sideload-windows.ps1",
    "core:pull": "git subtree pull --prefix=vendor/pptx-font-manager https://github.com/stoatworks-labs/pptx-font-manager.git main --squash"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "office-addin-dev-certs": "^1.13.5",
    "office-addin-manifest": "^1.13.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^5.0.1"
  }
}
