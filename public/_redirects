# wrangler.toml sets html_handling = "none" so that /taskpane.html — the URL in
# every installed manifest — is served as the file it names rather than with a
# 307 to /taskpane. "none" also stops / from meaning /index.html, so this puts
# exactly that one mapping back as a rewrite (200, not a redirect). Anything
# else unknown is a real 404.
/  /index.html  200
